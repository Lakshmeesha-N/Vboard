# Application
APP_NAME="Vboard Backend"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Meta / Llama API
META_API_KEY=""
META_BASE_URL="https://api.meta.ai/v1"

# Hugging Face
HF_TOKEN=""

# Default Models
DEFAULT_VOICE_MODEL="muse-voice-transcribe-1.0"
DEFAULT_LLM_MODEL=""

# Provider Selection ("meta", "sarvam", "openai" for STT; "meta", "openai", "groq", "google" for LLM)
STT_PROVIDER="meta"
LLM_PROVIDER="meta"

# Provider Keys & Overrides
SARVAM_API_KEY=""
SARVAM_VOICE_MODEL="saaras:v2"
SARVAM_BASE_URL="https://api.sarvam.ai"

OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_VOICE_MODEL="whisper-1"
OPENAI_LLM_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_LLM_MODEL="gemini-2.5-flash"

GROQ_API_KEY=""
GROQ_LLM_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
