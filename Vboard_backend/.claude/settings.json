{
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Bash(.venv/Scripts/python -m pytest:*)",
            "Bash(.venv/Scripts/python -m ruff:*)",
            "Bash(.\\.venv\\Scripts\\python.exe -m pytest:*)",
            "Bash(.\\.venv\\Scripts\\python.exe -m ruff:*)",
            "Bash(pytest:*)",
            "Bash(ruff:*)",
            "Bash(pip index versions:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git log:*)"
        ],
        "deny": [
            "Bash(git push:*)",
            "Bash(git add -A:*)",
            "Bash(git add .:*)",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(../Vboard-android/**)",
            "Edit(../Vboard-android/**)"
        ]
    }
}