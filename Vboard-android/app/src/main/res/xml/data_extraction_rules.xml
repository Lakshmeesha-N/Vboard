<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Device ID must stay unique per install; never restore it. -->
        <exclude domain="sharedpref" path="vboard_id.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vboard_id.xml" />
    </device-transfer>
</data-extraction-rules>
